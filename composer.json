{
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^7.1.3",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "bref/bref": "^0.5.15",
    "symfony/amazon-mailer": "5.0.*",
    "symfony/console": "5.0.*",
    "symfony/dotenv": "5.0.*",
    "symfony/flex": "^1.3.1",
    "symfony/framework-bundle": "5.0.*",
    "symfony/mailer": "5.0.*",
    "symfony/orm-pack": "^1.0",
    "symfony/twig-bundle": "5.0.*",
    "symfony/yaml": "5.0.*"
  },
  "require-dev": {
    "doctrine/doctrine-fixtures-bundle": "^3.3",
    "jimmyd-github/boxer-ratings-mysql": "^1.0.0",
    "roave/security-advisories": "dev-master",
    "symfony/maker-bundle": "^1.14",
    "symfony/test-pack": "^1.0",
    "symfony/var-dumper": "5.0.*"
  },
  "config": {
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "replace": {
    "paragonie/random_compat": "2.*",
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php71": "*",
    "symfony/polyfill-php70": "*",
    "symfony/polyfill-php56": "*"
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "app-deploy": [
      "APP_ENV=prod APP_DEBUG=0 php bin/console cache:clear",
      "APP_ENV=prod composer install --prefer-dist --optimize-autoloader --no-dev",
      "rm -rf var/cache/dev",
      "serverless deploy"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "5.0.*"
    }
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/jimmyd-github/boxer-ratings-mysql"
    }
  ]
}
