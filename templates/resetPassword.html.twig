{% extends 'base.html.twig' %}

{% block title %}Reset Password{% endblock %}

{% block content %}
    <tr>
        <td class="wrapper">
            <table role="presentation" border="0" cellpadding="0" cellspacing="0">
                <tr>
                    <td>
                        <p>Hi {{ name }},</p>
                        <p>Please click the button below to reset your BoxerRatings.com password.</p>
                        <table role="presentation" border="0" cellpadding="0" cellspacing="0" class="btn btn-primary">
                            <tbody>
                            <tr>
                                <td align="left">
                                    <table role="presentation" border="0" cellpadding="0" cellspacing="0">
                                        <tbody>
                                        <tr>
                                            <td>
                                                <a href="{{ url }}" target="_blank">
                                                    Reset Password
                                                </a>
                                            </td>
                                        </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                            </tbody>
                        </table>
                        <p>If you did not expect to receive this email you might want to review the security on your
                            email account.</p>
                        <p>Cheers, <br>BoxerRatings.com</p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
{% endblock %}